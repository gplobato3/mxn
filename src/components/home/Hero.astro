---
import { u } from '../../lib/url';
import { responsive } from '../../lib/images';
import Icon from '../Icon.astro';
import { materials } from '../../data/catalog';
import { money } from '../../lib/format';
import { store } from '../../config/store';

const desk = await responsive('hero-desktop', [1280, 1600, 2000, 2400], 70);
const mob = await responsive('hero-mobile', [480, 720, 960, 1208], 70);
---

<section class="hero">
  <div class="hero-media">
    <picture>
      <source media="(min-width: 900px)" type="image/avif" srcset={desk.avif} sizes="100vw" />
      <source media="(min-width: 900px)" type="image/webp" srcset={desk.webp} sizes="100vw" />
      <source media="(min-width: 900px)" srcset={desk.fallback} sizes="100vw" />
      <source type="image/avif" srcset={mob.avif} sizes="100vw" />
      <source type="image/webp" srcset={mob.webp} sizes="100vw" />
      <img
        srcset={mob.fallback}
        sizes="100vw"
        width={mob.width}
        height={mob.height}
        alt="Mujer con un collar de placa dorada grabado con el nombre Valeria"
        fetchpriority="high"
        decoding="sync"
      />
    </picture>
  </div>

  <div class="hero-copy wrap">
    <div class="hero-inner">
      <p class="eyebrow" data-reveal>{store.brand.tagline}</p>
      <h1 data-reveal style="--d:.08s">Su nombre,<br /><em class="italic">en oro.</em></h1>
      <p class="lead" data-reveal style="--d:.16s">
        Collares grabados con el nombre que más quieres. Escríbelo aquí y mira cómo queda antes de pagar.
      </p>

      <form class="try" action={u("/disena/placa")} method="get" data-try data-reveal style="--d:.24s">
        <div class="try-preview" aria-hidden="true" data-try-preview></div>
        <label class="sr-only" for="try-name">Nombre para grabar</label>
        <div class="try-row">
          <input
            id="try-name"
            name="nombre"
            class="input"
            type="text"
            inputmode="text"
            autocomplete="off"
            autocapitalize="words"
            spellcheck="false"
            maxlength="12"
            placeholder="Escribe su nombre"
            enterkeyhint="go"
            data-try-input
          />
          <button class="btn btn-gold" type="submit">
            Diseñar <Icon name="arrow" size={18} />
          </button>
        </div>
        <p class="try-note">
          Desde <strong>{money(materials.oro.price)} MXN</strong> · Envío gratis · Revisamos la ortografía contigo
        </p>
      </form>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: #efe5d6;
    overflow: hidden;
  }
  .hero-media {
    position: relative;
    aspect-ratio: 1208 / 1180;
    overflow: hidden;
  }
  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 62%;
    animation: heroIn 1.6s var(--ease) both;
  }
  @keyframes heroIn {
    from {
      transform: scale(1.06);
      filter: saturate(0.9);
    }
  }
  .hero-media::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 18%;
    background: linear-gradient(to bottom, rgb(239 229 214 / 0), #efe5d6 96%);
  }
  .hero-copy {
    position: relative;
    margin-top: -6px;
    padding-top: 6px;
    padding-bottom: 44px;
  }
  .hero-inner {
    display: grid;
    gap: 16px;
    max-width: 540px;
  }
  h1 em {
    font-weight: 500;
  }
  .try {
    margin-top: 10px;
    display: grid;
    gap: 12px;
    padding: 14px;
    border-radius: 22px;
    background: rgb(255 253 249 / 0.82);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border: 1px solid rgb(255 255 255 / 0.7);
    box-shadow: var(--shadow-1);
  }
  .try-preview {
    height: 92px;
    border-radius: 14px;
    background: radial-gradient(120% 140% at 50% 0%, #fffaf1, #efe3d0);
    overflow: hidden;
    display: grid;
    place-items: center;
  }
  .try-preview :global(svg) {
    width: 230px;
    max-width: none;
  }
  .try-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 8px;
  }
  .try-row .input {
    min-height: 54px;
    border-radius: 999px;
    padding-inline: 20px;
    font-family: var(--serif);
    font-size: 1.3rem;
  }
  .try-row .input::placeholder {
    font-family: var(--sans);
    font-size: 0.92rem;
    color: #9a8d80;
  }
  .try-row .btn {
    padding: 0 22px;
  }
  .try-note {
    font-size: 0.78rem;
    color: var(--muted);
    text-align: center;
  }

  @media (min-width: 900px) {
    .hero {
      min-height: min(92svh, 880px);
      display: grid;
    }
    .hero-media {
      position: absolute;
      inset: 0;
      aspect-ratio: auto;
    }
    .hero-media img {
      object-position: 70% 30%;
    }
    .hero-media::after {
      inset: 0 auto 0 0;
      width: 55%;
      height: auto;
      background: linear-gradient(to right, rgb(243 234 221 / 0.65), rgb(243 234 221 / 0));
    }
    .hero-copy {
      margin: 0 auto;
      align-self: center;
      padding-block: 96px;
    }
    .hero-inner {
      gap: 20px;
    }
    .try {
      max-width: 470px;
    }
    .try-preview {
      height: 110px;
    }
    .try-preview :global(svg) {
      width: 280px;
    }
  }
</style>

<script>
  import { renderStudio, loadPreviewFonts } from '../../lib/pendant';
  import type { Design } from '../../data/catalog';

  const box = document.querySelector<HTMLElement>('[data-try-preview]');
  const input = document.querySelector<HTMLInputElement>('[data-try-input]');
  const names = ['Valeria', 'Ximena', 'Camila', 'Regina', 'Sofía', 'Mamá'];
  let typed = false;
  let i = 0;

  function draw(text: string) {
    if (!box) return;
    const d: Design = { product: 'placa', text, font: 'script', material: 'oro', length: 45 };
    box.innerHTML = renderStudio(d);
  }

  loadPreviewFonts().then(() => {
    draw(names[0]);
    // gira alguns nomes até a pessoa digitar
    const timer = setInterval(() => {
      if (typed) return clearInterval(timer);
      i = (i + 1) % names.length;
      draw(names[i]);
    }, 2200);
  });

  input?.addEventListener('input', () => {
    typed = true;
    draw(input.value.trim() || names[0]);
  });
</script>
