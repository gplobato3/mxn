---
import Icon from './Icon.astro';
import { store } from '../config/store';
const items = [
  { icon: 'eye', text: 'Vista previa antes de pagar' },
  { icon: 'check', text: 'Revisamos la ortografía contigo' },
  { icon: 'truck', text: `Recíbelo en ${store.timing.totalDays}` },
  { icon: 'shield', text: 'Reposición si llega con defecto' },
] as const;
---

<div class="trust">
  <ul class="wrap">
    {
      items.map((it) => (
        <li>
          <Icon name={it.icon} size={18} />
          <span>{it.text}</span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .trust {
    border-block: 1px solid var(--line);
    background: var(--paper);
  }
  ul {
    list-style: none;
    margin: 0 auto;
    padding-block: 16px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px 18px;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--ink-2);
  }
  li {
    display: flex;
    gap: 9px;
    align-items: center;
  }
  li :global(svg) {
    color: var(--gold-deep);
    flex: none;
  }
  @media (min-width: 900px) {
    ul {
      grid-template-columns: repeat(4, auto);
      justify-content: space-between;
      font-size: 0.86rem;
      padding-block: 20px;
    }
  }
</style>
