---
import { responsive } from '../lib/images';
interface Props {
  name: string;
  alt: string;
  sizes?: string;
  widths?: number[];
  class?: string;
  eager?: boolean;
  quality?: number;
}
const { name, alt, sizes = '100vw', widths = [480, 720, 960, 1280, 1600], class: cls, eager = false, quality = 72 } = Astro.props;
const r = await responsive(name, widths, quality);
---

<picture class={cls}>
  <source type="image/avif" srcset={r.avif} sizes={sizes} />
  <source type="image/webp" srcset={r.webp} sizes={sizes} />
  <img
    srcset={r.fallback}
    sizes={sizes}
    width={r.width}
    height={r.height}
    alt={alt}
    loading={eager ? 'eager' : 'lazy'}
    decoding={eager ? 'sync' : 'async'}
    fetchpriority={eager ? 'high' : undefined}
  />
</picture>

<style>
  picture {
    display: block;
    height: 100%;
  }
  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
