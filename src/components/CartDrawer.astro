---
import Icon from './Icon.astro';
import { productList } from '../data/catalog';
import { store } from '../config/store';
---

<div class="drawer" data-cart hidden>
  <div class="drawer-backdrop" data-cart-close></div>
  <aside class="drawer-panel" role="dialog" aria-modal="true" aria-labelledby="cart-title">
    <header class="drawer-head">
      <h2 id="cart-title">Tu bolsa <span class="muted" data-cart-n></span></h2>
      <button class="x" type="button" aria-label="Cerrar bolsa" data-cart-close><Icon name="close" size={22} /></button>
    </header>

    {
      store.bundle.enabled && (
        <div class="bundle" data-bundle>
          <p data-bundle-text>{store.bundle.label}</p>
          <div class="bundle-bar">
            <span data-bundle-bar />
          </div>
        </div>
      )
    }

    <div class="drawer-body" data-cart-body>
      <ul class="lines" data-cart-lines></ul>

      <div class="empty" data-cart-empty hidden>
        <p class="display-sm">Tu bolsa está vacía</p>
        <p class="muted">Elige un diseño y mira cómo queda con su nombre.</p>
        <div class="empty-links">
          {
            productList.map((p) => (
              <a class="btn btn-ghost btn-sm" href={`/disena/${p.slug}`}>
                {p.shortName}
              </a>
            ))
          }
        </div>
      </div>

      <div class="upsell" data-cart-upsell hidden>
        <p class="eyebrow">Completa el regalo</p>
        <div class="upsell-row">
          {
            productList.map((p) => (
              <a href={`/disena/${p.slug}`} data-upsell={p.id}>
                <span>{p.shortName}</span>
                <Icon name="arrow" size={16} />
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <footer class="drawer-foot" data-cart-foot hidden>
      <dl class="sum">
        <div><dt>Subtotal</dt><dd data-sum-sub></dd></div>
        <div data-sum-disc-row hidden><dt>Descuento por 2 piezas</dt><dd class="ok" data-sum-disc></dd></div>
        <div><dt>Envío</dt><dd data-sum-ship>Gratis</dd></div>
        <div class="total"><dt>Total</dt><dd data-sum-total></dd></div>
      </dl>
      <a href="/checkout" class="btn btn-block" data-go-checkout>
        <Icon name="lock" size={18} /> Finalizar compra
      </a>
      <p class="foot-note">
        <Icon name="check" size={15} /> Te confirmamos la ortografía por WhatsApp antes de grabar
      </p>
    </footer>
  </aside>
</div>

<style>
  .drawer {
    position: fixed;
    inset: 0;
    z-index: 70;
  }
  .drawer-backdrop {
    position: absolute;
    inset: 0;
    background: rgb(31 25 21 / 0.4);
    opacity: 0;
    transition: opacity 0.35s;
  }
  .drawer-panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(100vw, 440px);
    background: var(--ivory);
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    transform: translateX(100%);
    transition: transform 0.5s var(--ease);
    box-shadow: var(--shadow-2);
  }
  .drawer.open .drawer-backdrop {
    opacity: 1;
  }
  .drawer.open .drawer-panel {
    transform: none;
  }
  .drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px 12px;
  }
  .drawer-head h2 {
    font-size: 1.7rem;
  }
  .drawer-head .muted {
    font-family: var(--sans);
    font-size: 0.9rem;
  }
  .x {
    width: 44px;
    height: 44px;
    border: 0;
    background: transparent;
    display: grid;
    place-items: center;
    border-radius: 99px;
    margin-right: -8px;
  }
  .bundle {
    margin: 0 20px 6px;
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    background: var(--sand);
    font-size: 0.84rem;
    font-weight: 500;
    display: grid;
    gap: 8px;
  }
  .bundle-bar {
    height: 4px;
    border-radius: 9px;
    background: rgb(31 25 21 / 0.1);
    overflow: hidden;
  }
  .bundle-bar span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--gold-grad);
    transition: width 0.6s var(--ease);
  }
  .drawer-body {
    overflow-y: auto;
    padding: 6px 20px 20px;
    overscroll-behavior: contain;
  }
  .lines {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .lines :global(li) {
    display: grid;
    grid-template-columns: 92px 1fr;
    gap: 14px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }
  .lines :global(.thumb) {
    width: 92px;
    aspect-ratio: 1;
    border-radius: 12px;
    background: radial-gradient(120% 90% at 50% 30%, #fbf7f1, #ece2d4);
    overflow: hidden;
    display: grid;
    place-items: center;
  }
  .lines :global(.thumb svg) {
    width: 165%;
    max-width: none;
  }
  .lines :global(.l-title) {
    font-weight: 600;
    font-size: 0.95rem;
  }
  .lines :global(.l-text) {
    font-family: var(--serif);
    font-size: 1.25rem;
    font-style: italic;
    line-height: 1.2;
  }
  .lines :global(.l-meta) {
    font-size: 0.78rem;
    color: var(--muted);
  }
  .lines :global(.l-row) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 10px;
  }
  .lines :global(.qty) {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--line-2);
    border-radius: 99px;
    height: 36px;
  }
  .lines :global(.qty button) {
    width: 36px;
    height: 34px;
    border: 0;
    background: transparent;
    display: grid;
    place-items: center;
  }
  .lines :global(.qty span) {
    min-width: 18px;
    text-align: center;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .lines :global(.l-price) {
    font-weight: 600;
  }
  .lines :global(.rm) {
    border: 0;
    background: transparent;
    font-size: 0.76rem;
    color: var(--muted);
    text-decoration: underline;
    padding: 6px 0;
    margin-top: 4px;
  }
  .empty {
    text-align: center;
    display: grid;
    gap: 10px;
    padding: 48px 0;
    justify-items: center;
  }
  .display-sm {
    font-family: var(--serif);
    font-size: 1.8rem;
  }
  .empty-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
    margin-top: 10px;
  }
  .upsell {
    margin-top: 18px;
    display: grid;
    gap: 10px;
  }
  .upsell-row {
    display: grid;
    gap: 8px;
  }
  .upsell-row a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 16px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
    background: var(--paper);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.92rem;
  }
  .drawer-foot {
    border-top: 1px solid var(--line);
    padding: 14px 20px calc(16px + env(safe-area-inset-bottom));
    background: var(--paper);
    display: grid;
    gap: 12px;
  }
  .sum {
    margin: 0;
    display: grid;
    gap: 6px;
    font-size: 0.9rem;
  }
  .sum div {
    display: flex;
    justify-content: space-between;
  }
  .sum dt {
    color: var(--muted);
  }
  .sum dd {
    margin: 0;
    font-weight: 600;
  }
  .sum .ok {
    color: var(--ok);
  }
  .sum .total {
    font-size: 1.05rem;
    padding-top: 6px;
    border-top: 1px dashed var(--line-2);
  }
  .sum .total dt {
    color: var(--ink);
    font-weight: 600;
  }
  .foot-note {
    display: flex;
    gap: 8px;
    align-items: center;
    justify-content: center;
    font-size: 0.78rem;
    color: var(--muted);
  }
</style>

<script>
  import { cart, type CartLine } from '../lib/cart';
  import { describeDesign, products } from '../data/catalog';
  import { renderStudio, loadPreviewFonts } from '../lib/pendant';
  import { money } from '../lib/format';
  import { store } from '../config/store';

  const root = document.querySelector<HTMLElement>('[data-cart]')!;
  const list = root.querySelector<HTMLUListElement>('[data-cart-lines]')!;
  const empty = root.querySelector<HTMLElement>('[data-cart-empty]')!;
  const foot = root.querySelector<HTMLElement>('[data-cart-foot]')!;
  const upsell = root.querySelector<HTMLElement>('[data-cart-upsell]')!;
  const counts = document.querySelectorAll<HTMLElement>('[data-cart-count]');
  const shipping = store.shipping.find((s) => s.enabled)?.price ?? 0;

  const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  function lineHtml(l: CartLine): string {
    const p = products[l.design.product];
    const unit = cart.unit(l);
    const extras = [l.design.giftBox ? store.addons.giftBox.label : '', l.design.giftNote ? 'Con dedicatoria' : '']
      .filter(Boolean)
      .join(' · ');
    return `<li data-id="${l.id}">
      <div class="thumb">${renderStudio(l.design)}</div>
      <div>
        <p class="l-title">${esc(p.shortName)}</p>
        <p class="l-text">“${esc(l.design.text)}”</p>
        <p class="l-meta">${esc(describeDesign(l.design))}${extras ? '<br>' + esc(extras) : ''}</p>
        <div class="l-row">
          <div class="qty" role="group" aria-label="Cantidad">
            <button type="button" data-dec aria-label="Quitar uno">−</button>
            <span>${l.qty}</span>
            <button type="button" data-inc aria-label="Agregar uno">+</button>
          </div>
          <span class="l-price">${money(unit * l.qty)}</span>
        </div>
        <button type="button" class="rm" data-rm>Eliminar</button>
      </div>
    </li>`;
  }

  function render() {
    const lines = cart.lines();
    const n = cart.count();
    counts.forEach((c) => {
      c.hidden = n === 0;
      if (c.textContent !== String(n)) {
        c.textContent = String(n);
        c.classList.remove('bump');
        void c.offsetWidth;
        c.classList.add('bump');
      }
    });
    root.querySelector('[data-cart-n]')!.textContent = n ? `(${n})` : '';
    list.innerHTML = lines.map(lineHtml).join('');
    empty.hidden = lines.length > 0;
    foot.hidden = lines.length === 0;
    upsell.hidden = !(lines.length > 0 && n < store.bundle.minItems);

    const t = cart.totals(shipping);
    root.querySelector('[data-sum-sub]')!.textContent = money(t.subtotal);
    root.querySelector('[data-sum-disc]')!.textContent = `−${money(t.discount)}`;
    root.querySelector<HTMLElement>('[data-sum-disc-row]')!.hidden = t.discount === 0;
    root.querySelector('[data-sum-ship]')!.textContent = t.shipping ? money(t.shipping) : 'Gratis';
    root.querySelector('[data-sum-total]')!.textContent = money(t.total);

    const bText = root.querySelector('[data-bundle-text]');
    const bBar = root.querySelector<HTMLElement>('[data-bundle-bar]');
    if (bText && bBar && store.bundle.enabled) {
      const left = Math.max(0, store.bundle.minItems - n);
      bText.textContent =
        n === 0 ? store.bundle.label : left > 0 ? `Agrega ${left} pieza más y ahorra ${money(store.bundle.discount)}` : `Listo: ahorraste ${money(store.bundle.discount)} en tu pedido`;
      bBar.style.width = `${Math.min(100, (n / store.bundle.minItems) * 100)}%`;
    }
  }

  list.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('button');
    const li = (e.target as HTMLElement).closest<HTMLElement>('li[data-id]');
    if (!btn || !li) return;
    const id = li.dataset.id!;
    const line = cart.lines().find((l) => l.id === id);
    if (!line) return;
    if (btn.hasAttribute('data-inc')) cart.setQty(id, line.qty + 1);
    if (btn.hasAttribute('data-dec')) line.qty > 1 ? cart.setQty(id, line.qty - 1) : cart.remove(id);
    if (btn.hasAttribute('data-rm')) cart.remove(id);
  });

  let lastFocus: Element | null = null;
  function open() {
    lastFocus = document.activeElement;
    root.hidden = false;
    requestAnimationFrame(() => root.classList.add('open'));
    document.documentElement.style.overflow = 'hidden';
    setTimeout(() => root.querySelector<HTMLElement>('[data-cart-close].x')?.focus(), 60);
  }
  function close() {
    root.classList.remove('open');
    document.documentElement.style.overflow = '';
    setTimeout(() => (root.hidden = true), 450);
    (lastFocus as HTMLElement | null)?.focus?.();
  }

  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (t.closest('[data-cart-open]')) {
      e.preventDefault();
      open();
    }
    if (t.closest('[data-cart-close]')) close();
  });
  document.addEventListener('keydown', (e) => e.key === 'Escape' && !root.hidden && close());
  window.addEventListener('cart:open', open);

  cart.onChange(render);
  render();
  loadPreviewFonts().then(render);
</script>
