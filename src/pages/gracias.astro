---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { store, whatsappEnabled } from '../config/store';
const isEndpoint = store.payment.mode === 'endpoint';
---

<Base title="Gracias por tu pedido" noindex bare>
  <section class="ty" data-ty>
    <div class="wrap ty-in">
      <div class="seal" data-ty-seal aria-hidden="true"><Icon name="check" size={30} /></div>
      <p class="eyebrow" data-ty-eyebrow>{isEndpoint ? 'Un momento' : 'Pedido apartado'}</p>
      <h1 data-ty-title>{isEndpoint ? 'Verificando tu pago…' : 'Falta un paso: confírmalo por WhatsApp'}</h1>
      <p class="lead" data-ty-lead>
        {
          isEndpoint
            ? 'Estamos confirmando tu pago con el banco.'
            : 'Envíanos tu pedido por WhatsApp para recibir el enlace de pago seguro. En cuanto se confirme, grabamos tu pieza.'
        }
      </p>
      <p class="order-id" data-ty-id hidden></p>

      {
        isEndpoint && (
          <a class="btn big" href={u('/pago')} data-ty-pay hidden>
            Ver mis datos de pago
          </a>
        )
      }
      {
        !isEndpoint && whatsappEnabled && (
          <a class="btn btn-gold big" href="#" target="_blank" rel="noopener" data-ty-wa>
            <Icon name="whatsapp" size={22} /> Enviar mi pedido por WhatsApp
          </a>
        )
      }
      {
        !isEndpoint && !whatsappEnabled && (
          <p class="warn">Configura el número de WhatsApp en src/config/store.ts para activar este paso.</p>
        )
      }

      <ol class="next">
        <li><span>1</span> Confirmamos la ortografía contigo por WhatsApp.</li>
        <li><span>2</span> Grabamos tu pieza en {store.timing.productionDays}.</li>
        <li><span>3</span> Te enviamos la guía de rastreo. Llega en {store.timing.totalDays}.</li>
      </ol>

      <a href={u("/")} class="link-arrow">Volver a la tienda <Icon name="arrow" size={16} /></a>
    </div>
  </section>
</Base>

<style>
  .ty {
    padding: 56px 0 96px;
  }
  .ty-in {
    max-width: 640px;
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 16px;
  }
  .seal {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--gold-grad);
    color: var(--ink);
    box-shadow: var(--shadow-1);
    animation: pop 0.8s var(--ease) both;
    transition: opacity 0.3s;
  }
  .seal.wait {
    opacity: 0.35;
  }
  @keyframes pop {
    from {
      transform: scale(0.6);
      opacity: 0;
    }
  }
  h1 {
    font-size: clamp(2.2rem, 6vw, 3.4rem);
  }
  .order-id {
    font-size: 0.85rem;
    padding: 8px 14px;
    border-radius: 99px;
    background: var(--sand);
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .big {
    min-height: 62px;
    font-size: 1.02rem;
    margin-top: 6px;
  }
  .warn {
    font-size: 0.85rem;
    color: var(--danger);
  }
  .next {
    list-style: none;
    margin: 18px 0 8px;
    padding: 0;
    display: grid;
    gap: 10px;
    text-align: left;
    width: 100%;
  }
  .next li {
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--paper);
    font-size: 0.92rem;
  }
  .next span {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    flex: none;
    display: grid;
    place-items: center;
    background: var(--ink);
    color: var(--ivory);
    font-size: 0.75rem;
    font-weight: 700;
  }
</style>

<script>
  import { fetchOrderStatus, loadOrder, orderMessage } from '../lib/order';
  import { cart } from '../lib/cart';
  import { track } from '../lib/track';
  import { store, whatsappLink } from '../config/store';
  import { u } from '../lib/url';

  const q = new URLSearchParams(location.search);
  const order = loadOrder();
  const id = q.get('pedido') || order?.id || '';
  const idEl = document.querySelector<HTMLElement>('[data-ty-id]');
  if (id && idEl) {
    idEl.textContent = `Pedido ${id}`;
    idEl.hidden = false;
  }

  if (store.payment.mode !== 'endpoint') {
    const wa = document.querySelector<HTMLAnchorElement>('[data-ty-wa]');
    if (wa && order) wa.href = whatsappLink(orderMessage(order));
  } else {
    const token = q.get('t') || (order?.id === id ? order?.token : '') || '';
    const set = (eyebrow: string, title: string, lead: string) => {
      document.querySelector('[data-ty-eyebrow]')!.textContent = eyebrow;
      document.querySelector('[data-ty-title]')!.textContent = title;
      document.querySelector('[data-ty-lead]')!.textContent = lead;
    };
    const seal = document.querySelector<HTMLElement>('[data-ty-seal]')!;
    const payBtn = document.querySelector<HTMLAnchorElement>('[data-ty-pay]')!;
    const payLink = () => {
      payBtn.href = u(`/pago?pedido=${encodeURIComponent(id)}&t=${encodeURIComponent(token)}`);
      payBtn.hidden = false;
    };
    seal.classList.add('wait');

    (async () => {
      if (!id || !token) {
        seal.classList.remove('wait');
        return set('Pedido recibido', '¡Gracias!', 'Si ya pagaste, te escribiremos por WhatsApp para confirmar la ortografía antes de grabar.');
      }
      try {
        const s = await fetchOrderStatus(id, token);
        if (!s) return set('Pedido no encontrado', 'No encontramos tu pedido', 'Escríbenos con tu número de pedido y lo revisamos.');
        if (s.status === 'paid') {
          seal.classList.remove('wait');
          set('Pago confirmado', '¡Gracias! Ya estamos en ello', 'Antes de grabar te escribiremos por WhatsApp para revisar la ortografía.');
          // Purchase só com pagamento confirmado pelo servidor, uma vez por pedido
          const flag = `nombra.purchased.${s.id}`;
          if (!localStorage.getItem(flag)) {
            track('Purchase', { value: s.totals.total, num_items: s.totals.items }, s.id);
            localStorage.setItem(flag, '1');
          }
          cart.clear();
        } else if (s.status === 'review') {
          seal.classList.remove('wait');
          set('Pago recibido', 'Estamos revisando tu pago', 'Recibimos un pago para este pedido y lo estamos verificando. Te escribimos por WhatsApp en cuanto quede listo.');
        } else if (s.status === 'pending') {
          set(
            'Pago pendiente',
            'Tu pago aún no se confirma',
            s.method === 'oxxo'
              ? 'Si ya pagaste en OXXO, la confirmación puede tardar unas horas.'
              : 'Si ya hiciste la transferencia, la confirmación suele tardar unos minutos.',
          );
          payLink();
        } else {
          set('Pago vencido', 'Este pago ya venció', 'No recibimos el pago a tiempo. Puedes generar uno nuevo desde tus datos de pago.');
          payLink();
        }
      } catch {
        set('Sin conexión', 'No pudimos verificar tu pago', 'Revisa tu conexión y recarga esta página.');
      }
    })();
  }
</script>
