# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.

# Dominio final de la tienda (sitemap, canonical, Open Graph)
SITE_URL=https://www.nombra.mx

# Píxeles (opcional). Déjalos vacíos para desactivarlos.
PUBLIC_META_PIXEL_ID=
PUBLIC_TIKTOK_PIXEL_ID=

# Pago con xpag (SPEI/OXXO) a través del Worker de Cloudflare: /api/checkout
# (npm run build:cf ya lo define). Si está vacío, la tienda funciona en modo "pedido por WhatsApp".
# Las credenciales de xpag NO van aquí: son secretos del Worker (npx wrangler secret put XPAG_CLIENT_ID ...).
PUBLIC_CHECKOUT_ENDPOINT=

# Opcional (modo WhatsApp): webhook que recibe cada pedido en JSON (Make, Zapier, n8n, Apps Script).
PUBLIC_ORDER_WEBHOOK=

# Solo para regenerar las fotos (scripts/generate-images.py). No lo uses en el sitio.
REPLICATE_API_TOKEN=
